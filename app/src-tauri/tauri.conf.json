{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ocarina Journal",
  "version": "1.0.0",
  "identifier": "dev.ocarinajournal.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Ocarina Journal", "width": 450, "height": 960, "minWidth": 330, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/THIRD_PARTY_LICENSES.txt"],
    "targets": ["nsis"],
    "publisher": "Ocarina Journal contributors",
    "copyright": "Copyright (C) 2026 Ocarina Journal contributors",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "windows": {
      "allowDowngrades": false,
      "nsis": { "installMode": "currentUser", "template": "windows/installer.nsi" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
